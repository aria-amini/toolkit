# This env file uses @env-spec. See https://varlock.dev/env-spec
# ---
# @defaultRequired=false @defaultSensitive=false
# @currentEnv=$APP_ENV
# @generateTsTypes(path=env.d.ts, importMetaEnv=none)
# @encryptInjectedEnv=forEnv(production, preview)
# @plugin(@varlock/hashicorp-vault-plugin)
# @import(./.env.workspace.local, allowMissing=true)
# @import(~/.config/openbao/.env.dev, allowMissing=true)
# @import(~/.config/openbao/{{ app_name }}/.env.dev, allowMissing=true)
# @initHcpVault(url=$OPENBAO_ADDR, token=fallback($OPENBAO_APP_TOKEN, $OPENBAO_TOKEN), roleId=$VAULT_ROLE_ID, secretId=$VAULT_SECRET_ID, defaultPath="secret/{{ app_name }}/${APP_ENV}")
# ---

# Set automatically by Railway and used to detect preview deployments.
RAILWAY_ENVIRONMENT_NAME=

# @type=enum(development, preview, production, test)
APP_ENV=if(isEmpty($RAILWAY_ENVIRONMENT_NAME), remap($VARLOCK_ENV, regex("preview"), preview, regex("production"), production, regex("prod"), production, regex("test"), test, regex(".*"), development), remap($RAILWAY_ENVIRONMENT_NAME, regex("production"), production, regex("prod"), production, regex(".*"), preview))

# @type=port @required
APP_PORT=

# @type=url @required
BASE_URL=

# Secrets come from OpenBao: vaultSecret() reads secret/{{ app_name }}/<env>,
# and shared values live at secret/shared/<env>. aria-amini/infra sets up
# access. Railway sets these for deployed builds (`mise run onboard` in infra);
# ~/.config/openbao/.env.dev sets the address and token locally.
# @type=url @internal
OPENBAO_ADDR=
# Deployed builds log in with the AppRole the infra repo sets in Railway.
# @internal
VAULT_ROLE_ID=
# @sensitive @internal
VAULT_SECRET_ID=
# Local dev reads with a development-only token from the same file. It can
# read secret/shared/development only.
# @sensitive @internal
OPENBAO_TOKEN=
# `mise run dev-token {{ app_name }}` in infra writes a second token, to
# ~/.config/openbao/{{ app_name }}/.env.dev, that can also read
# secret/{{ app_name }}/development. Without it, those reads are denied.
# @sensitive @internal
OPENBAO_APP_TOKEN=

# Secrets are checked where the code uses them.

# @type=url @required
BETTER_AUTH_URL=$BASE_URL
# @sensitive @required=forEnv(production, preview)
BETTER_AUTH_SECRET=
{% if google_auth -%}
# Holds the same value at secret/{{ app_name }}/preview and
# secret/{{ app_name }}/production: production handles a preview's Google
# sign-in callback. createAuth() can only check that it is set.
{% endif -%}
# @sensitive
OAUTH_PROXY_SECRET=

# @type=url @sensitive @required=forEnv(production, preview)
DATABASE_URL=

{% if google_auth -%}
# Dev reuses one shared "Desktop app" OAuth client from OpenBao's
# secret/shared/development: Google accepts any loopback port for those
# without registration, so every app/workspace signs in through its own daemon
# without per-app console setup. Deployed environments use a dedicated "Web
# application" client, set in .env.preview and .env.production.
GOOGLE_CLIENT_ID=
# @sensitive
GOOGLE_CLIENT_SECRET=

{% endif -%}
# S3-compatible object storage. Dev runs MinIO via docker-compose and creates
# the bucket on first use; production points at a pre-provisioned bucket.
AWS_S3_BUCKET_NAME=
AWS_REGION="us-east-1"
# @type=url
AWS_ENDPOINT_URL=
# @sensitive
AWS_ACCESS_KEY_ID=
# @sensitive
AWS_SECRET_ACCESS_KEY=

{% if posthog -%}
# @public
VITE_PUBLIC_POSTHOG_KEY=

{% endif -%}
{% if sentry -%}
VITE_PUBLIC_SENTRY_DSN=
# @sensitive
SENTRY_AUTH_TOKEN=
{%- endif %}
