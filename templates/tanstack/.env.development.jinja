{% if google_auth -%}
# The shared "Desktop app" Google client, which accepts any loopback port.
# Without an OpenBao dev token, as in CI, Google sign-in stays off.
GOOGLE_CLIENT_ID=if($OPENBAO_TOKEN, vaultSecret("secret/shared/development"))
GOOGLE_CLIENT_SECRET=if($OPENBAO_TOKEN, vaultSecret("secret/shared/development"))

{% endif -%}
# Auth talks to the daemon directly, not through the proxy URL.
BETTER_AUTH_URL=http://localhost:${APP_PORT}
