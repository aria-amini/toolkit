import { drizzleAdapter } from '@better-auth/drizzle-adapter'
import { betterAuth, type BetterAuthOptions } from 'better-auth'
{% if google_auth -%}
import { oAuthProxy } from 'better-auth/plugins'
{% endif -%}
import { tanstackStartCookies } from 'better-auth/tanstack-start'

import { getDb } from '@/db'
import { account, session, user, verification } from '@/db/schema'
import { serverEnv as env } from '@/env.server'

const appOrigin = new URL(env.BETTER_AUTH_URL).origin

export const allowedHosts = [
	'127.0.0.1:*',
	'localhost:*',
	'*.localhost',
	'*.localhost:*',
	'*.lvh.ariaamini.com',
	'{{ app_name }}-*.up.railway.app',
	'app-{{ app_name }}-*.up.railway.app',
]

export function getAuth() {
	const options: BetterAuthOptions = {
		appName: '{{ app_name }}',
		baseURL: {
			allowedHosts,
			protocol: 'auto',
			fallback: appOrigin,
		},
		secret: env.BETTER_AUTH_SECRET,
		database: drizzleAdapter(getDb(), {
			provider: 'pg',
			schema: { account, session, user, verification },
		}),
		emailAndPassword: { enabled: true, autoSignIn: true },
{%- if google_auth %}
		plugins:
			env.GOOGLE_CLIENT_ID && env.GOOGLE_CLIENT_SECRET
				? [
						// Dev uses a shared "Desktop app" Google OAuth client, which
						// accepts any loopback port without registration — so every
						// app/workspace bounces through its own daemon (appOrigin is
						// localhost:<port> in dev). In prod appOrigin is the real
						// domain and the proxy no-ops.
						oAuthProxy({
							productionURL: appOrigin,
							secret: env.OAUTH_PROXY_SECRET,
						}),
						tanstackStartCookies(),
					]
				: [tanstackStartCookies()],
{%- else %}
		plugins: [tanstackStartCookies()],
{%- endif %}
	}
{%- if google_auth %}

	if (env.GOOGLE_CLIENT_ID && env.GOOGLE_CLIENT_SECRET) {
		// Preview and production must share this secret, or Google sign-in fails.
		if (!env.OAUTH_PROXY_SECRET && env.APP_ENV !== 'development') {
			throw new Error(
				'OAUTH_PROXY_SECRET is not set. Google sign-in needs the same value in preview and production.',
			)
		}

		return betterAuth({
			...options,
			socialProviders: {
				google: {
					clientId: env.GOOGLE_CLIENT_ID,
					clientSecret: env.GOOGLE_CLIENT_SECRET,
				},
			},
		})
	}
{%- endif %}

	return betterAuth(options)
}
