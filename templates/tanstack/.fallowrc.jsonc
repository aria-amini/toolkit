{
	"ignoreExports": [
		{
			"file": "src/components/ui/**",
			"exports": ["*"],
		},
	],
	// shadcn component library + its support files: reachable only from each
	// other until an app route imports them
	"ignorePatterns": ["src/components/ui/**", "src/hooks/use-mobile.ts"],
	"ignoreDependencies": [
		// only imported by the fallow-ignored shadcn ui components
		"@base-ui/react",
	],
	"rules": {
		// Nitro bundles app code into .output, so packages the app imports are
		// devDependencies. dependencies holds only what runs outside the bundle:
		// varlock for `start`, and drizzle-orm and pg for migrations.
		"dev-dependencies-in-production": "off",
	},
}
