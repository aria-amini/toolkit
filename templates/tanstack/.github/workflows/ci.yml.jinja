{% raw -%}
name: CI

on:
  push:
  pull_request:

concurrency:
  group: ci-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  check:
    runs-on: ubuntu-24.04
    steps:
      - name: checkout
        uses: actions/checkout@v6
      - name: setup vite+
        uses: voidzero-dev/setup-vp@v1
        with:
          version: '1.1.0'
          cache: true
      - run: vp check
      - run: vp test run --project unit --passWithNoTests

  test-db:
    runs-on: ubuntu-24.04
    steps:
      - name: checkout
        uses: actions/checkout@v6
      - name: setup vite+
        uses: voidzero-dev/setup-vp@v1
        with:
          version: '1.1.0'
          cache: true
      - name: Run Tests
        run: vp test run --project server --passWithNoTests

  test-visual:
    runs-on: ubuntu-24.04
    steps:
      - name: checkout
        uses: actions/checkout@v6
      - name: setup vite+
        uses: voidzero-dev/setup-vp@v1
        with:
          version: '1.1.0'
          cache: true
      - name: Install Playwright Browsers
        run: vp exec playwright install chromium --with-deps --no-shell
      - name: Run Tests
        run: vp test run --project browser
      - name: Upload screenshot diff report
        if: failure()
        uses: actions/upload-artifact@v7
        with:
          name: visual-test-report
          path: .vitest/attachments/
          include-hidden-files: true
          retention-days: 14
{% endraw -%}
